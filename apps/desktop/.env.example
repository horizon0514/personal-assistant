# 复制为 .env 并填入你的值。主进程读 MAIN_VITE_ 前缀变量。
MAIN_VITE_PROVIDER=deepseek
MAIN_VITE_MODEL=deepseek-v4-flash
MAIN_VITE_API_KEY=

# 视觉(读图):扫描件/表格走「页面渲染成图 → 视觉模型读」需要支持图片输入的模型。
# deepseek-v4-flash 实测拒图;用完整多模态的 deepseek-v4-pro,并开 forceVision
# (pi-ai 元数据把 deepseek 全系标成纯文本,需手动覆盖才会真把图发出去)。
# 开启后 view_document_pages / browser_screenshot 工具才会暴露给模型。
#   MAIN_VITE_MODEL=deepseek-v4-pro
#   MAIN_VITE_VISION=1
